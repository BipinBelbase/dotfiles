#!/usr/bin/env bash
set -euo pipefail

command -v fzf >/dev/null 2>&1 || {
  printf '%s\n' 'tmux-sessionizer requires fzf.' >&2
  exit 1
}

selected=$(find "$HOME" \
  -type d \( -name .git -o -name node_modules -o -name .cache \
    -o -name .local -o -name .oh-my-zsh -o -name .tmux \) -prune -o \
  -type d -print | fzf) || exit 0
[[ -n "$selected" ]] || exit 0

selected_name=$(basename "$selected" | tr '.:' '__')
selected_name=${selected_name//[^[:alnum:]_-]/_}
[[ -n "$selected_name" ]] || selected_name=home

if [[ -z "${TMUX:-}" ]]; then
  exec tmux new-session -A -s "$selected_name" -c "$selected"
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi
exec tmux switch-client -t "$selected_name"
