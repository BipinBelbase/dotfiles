" =========================
" LazyVim-style IdeaVim for PyCharm
" =========================

set number
set relativenumber
set clipboard=unnamedplus
set ignorecase
set smartcase
set incsearch
set hlsearch
set scrolloff=8
set sidescrolloff=8

let mapleader=" "

" Shift+H / Shift+L = previous/next editor tab
" Leader + hjkl = move between split panes
nnoremap <leader>h <C-w>h
nnoremap <leader>j <C-w>j
nnoremap <leader>k <C-w>k
nnoremap <leader>l <C-w>l

" Disable accidental leader-leader (like <leader><leader> = <nop>)
nnoremap <leader><leader> <nop>

" " Better escape
" inoremap jk <Esc>
" inoremap jj <Esc>

" Keep search results centered (n/N like nzzzv)
nnoremap n nzzzv
nnoremap N Nzzzv

" Join line but keep cursor position (J = mzJ`z)
nnoremap J mzJ`z

" Keep half-page moves centered
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

" Your Enter/Backspace scroll idea (closest)
nnoremap <CR> <C-d>zz
nnoremap <BS> <C-u>zz
vnoremap <CR> <C-d>zz

" Visual move lines up/down (J/K)
vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

" Quit
nnoremap <C-q> :q<CR>

" Save (CMD+S workaround - IdeaVim understands <D-s> on macOS)
nnoremap <D-s> :w<CR>

" ---------------------------------
" Clipboard mappings (match your intent)
" ---------------------------------
" Leader+Y = yank line to system clipboard
nnoremap <leader>Y "+Y

" Leader+y = yank to system clipboard (normal+visual)
nnoremap <leader>y "+y
vnoremap <leader>y "+y

" Disable plain <leader>p (you did <Nop>)
nnoremap <leader>p <nop>
vnoremap <leader>p <nop>

" Leader+pp = paste from system clipboard (normal+visual)
nnoremap <leader>pp "+p
vnoremap <leader>pp "+p

" Leader+pn in visual: paste without overwriting register (blackhole)
xnoremap <leader>pn "_dP

" Leader+d delete to blackhole (normal+visual)
nnoremap <leader>d "_d
vnoremap <leader>d "_d

" ---------------------------------
" Explorer / Side menu toggle
" ---------------------------------
" Space e = toggle Project (file explorer)
nnoremap <leader>e :action ActivateProjectToolWindow<CR>

" If you want "toggle" behavior more explicitly, also map:
" nnoremap <leader>E :action HideAllWindows<CR>

" Netrw-like mapping: <leader>pv -> project view
nnoremap <leader>pv :action ActivateProjectToolWindow<CR>

" ---------------------------------
" Diagnostics / Problems (your <leader>j/k and cb)
" ---------------------------------
" Next/Prev error (closest to vim.diagnostic.goto_next/prev)
nnoremap <leader>j :action GotoNextError<CR>
nnoremap <leader>k :action GotoPreviousError<CR>

" Open "diagnostic float" equivalent:
" In PyCharm the closest is showing intention/inspection info at caret.
nnoremap <leader>cb :action ShowIntentionActions<CR>

" Open Problems tool window
nnoremap <leader>ee :action ActivateProblemsViewToolWindow<CR>

" ---------------------------------
" Find & Replace (your <leader>fr)
" ---------------------------------
" Project-wide find/replace (closest and more powerful)
nnoremap <leader>fr :action ReplaceInPath<CR>

" If you specifically want "replace word under cursor" style, add:
" nnoremap <leader>fw :action FindWordAtCaret<CR>

" Disable Ex mode (Q = <nop>)
nnoremap Q <nop>

" ---------------------------------
" Terminal / "floating terminal" substitutes
" ---------------------------------
" IdeaVim cannot open floating terminals. Use PyCharm Terminal tool window.
nnoremap <leader>tt :action TerminalToolwindow<CR>

" Your tmux-sessionizer on <C-f>:
" IdeaVim cannot run Lua logic; map to Terminal and you can run sessionizer manually.
nnoremap <C-f> :action TerminalToolwindow<CR>

" ---------------------------------
" Run / Debug (closest to your runner)
" ---------------------------------
nnoremap <leader>rr :action Run<CR>
nnoremap <leader>rd :action Debug<CR>
nnoremap <leader>rs :action Stop<CR>

" ---------------------------------
" Window / Split navigation (your earlier tmux-like keys)
" ---------------------------------
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

nnoremap <leader>wh :action SplitHorizontally<CR>
nnoremap <leader>wv :action SplitVertically<CR>
nnoremap <leader>wq :action CloseContent<CR>
nnoremap <leader>wo :action UnsplitAll<CR>

" Resize splits (Ctrl+Arrows) - IdeaVim supports Ex resize
nnoremap <C-Up> :resize +2<CR>
nnoremap <C-Down> :resize -2<CR>
nnoremap <C-Left> :vertical resize -2<CR>
nnoremap <C-Right> :vertical resize +2<CR>
