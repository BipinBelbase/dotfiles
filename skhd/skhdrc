#
# Restart whichever current/legacy launchd labels are installed and verify yabai.
cmd + shift - r : $HOME/.config/yabai/wm-doctor.sh restart; osascript -e 'display notification "Restart checked; run wm-doctor.sh diagnose if keys fail" with title "Window Manager"'

# Resize windows
# Resize Left
cmd + shift - left  : yabai -m window --resize left:-20:0

# Resize Right
cmd + shift - right : yabai -m window --resize right:20:0

# Resize Up
cmd + shift - up    : yabai -m window --resize top:0:-20

# Resize Down
cmd + shift - down  : yabai -m window --resize bottom:0:20
